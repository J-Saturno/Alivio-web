# Copiar como application-local.properties (ignorado por Git).
# Crear primero una base nueva llamada alivio_web.
spring.datasource.url=jdbc:postgresql://localhost:5432/alivio_web
spring.datasource.username=postgres
spring.datasource.password=

# Acceso a la web administrativa: credenciales distintas de PostgreSQL.
# Completar ambos valores antes de iniciar; no subir este archivo local a GitHub.
alivio.admin.username=
alivio.admin.password=
